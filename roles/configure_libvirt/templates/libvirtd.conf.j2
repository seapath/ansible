# Disable the TLS and TCP socket
listen_tls = 0
listen_tcp = 0

{% set _perms = '0770' if configure_libvirt_socket_mode == '0660' else '0700' %}
{% if configure_libvirt_allow_non_root_libvirt_socket_access | bool %}
# Non-root access to the libvirt socket is enabled. Members of the "libvirt"
# group can read and write the socket, which is root-equivalent.
{% elif configure_libvirt_socket_trusted_group %}
# Non-root access to the libvirt socket is disabled, except for the
# {{ configure_libvirt_socket_trusted_user }} system user (group
# {{ configure_libvirt_socket_trusted_group }}).
{% else %}
# Non-root access to the libvirt socket is disabled: only root can read and
# write the socket.
{% endif %}
unix_sock_ro_perms = "{{ _perms }}"
unix_sock_rw_perms = "{{ _perms }}"
unix_sock_group = "{{ configure_libvirt_socket_group }}"

# Derive the host UUID from /etc/machine-id for a stable identity across
# libvirtd restarts without depending on dmidecode or inventory-computed values.
host_uuid_source = "machine-id"
