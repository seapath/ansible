<!--
  Generic VM template
  This file uses a templated to work with a specific VM inventory,
  see examples/inventories/vms_inventory_example.yaml
-->

{% set vm_features = vm.vm_features if "vm_features" in vm else [] %}
{% set vm_legacy_bios = vm.legacy_bios if "legacy_bios" in vm else false %}
{% set cpu_nb = (vm.cpuset | length) if vm.cpuset is defined else vm.nb_cpu | default(1) %}
{% set pinned_devices = (vm.pci_passthrough | default([])) + (vm.bridges | default([])) %}
{% set pinned_root_port_indexes = pinned_devices | selectattr("guest_address", "defined") | map(attribute="guest_address.bus") | map("int", base=16) | unique | sort %}
{% for root_port_index in pinned_root_port_indexes if root_port_index < 1 %}{{ undef("guest_address.bus must name a pcie-root-port from 0x01 upwards; 0x00 is the pcie-root itself") }}{% endfor %}
{% macro guest_pci_address(guest_address) %}<address type="pci" domain="{{ guest_address.domain | default('0x0000') }}" bus="{{ "0x%02x" | format(guest_address.bus | int(base=16)) }}" slot="{{ guest_address.slot | default('0x00') }}" function="{{ guest_address.function | default('0x0') }}"/>{% endmacro %}

<domain type="{{ vm.vm_domain_type | default('kvm') }}">
    <name>{{ vm.inventory_hostname }}</name>
    <uuid>{{ vm.uuid |default( 9999999999999999999999 | random | to_uuid) }}</uuid>
    <description>
        {{ vm.description |default("Test VM") }}
    </description>
{% if cpumachines is defined %}
    <resource>
{% if "rt" in vm_features %}
        <partition>/machine/rt</partition>
{% else %}
        <partition>/machine/nort</partition>
{% endif %}
    </resource>
{% endif %}
    <vcpu placement="static">{{ cpu_nb }}</vcpu>
{% if "dpdk" in vm_features %}
    <memory unit="GiB">1</memory>
    <currentMemory unit="GiB">1</currentMemory>
    <memoryBacking>
        <hugepages>
            <page size="1" unit="G"/>
        </hugepages>
        <nosharepages/>
    </memoryBacking>
{% else %}
    <memory unit="MiB">{{ vm.memory | default ("2048") }}</memory>
    <currentMemory unit="MiB">{{ vm.memory | default ("2048") }}</currentMemory>
{% endif %}
    <os{% if not vm_legacy_bios %} firmware="efi"{% endif %}>
        <type arch="x86_64" machine="q35">hvm</type>
        <boot dev="hd" />
        <bootmenu enable="no" />
{% if not vm_legacy_bios %}
        <bios useserial="yes" rebootTimeout="0" />
        <smbios mode="emulate" />
        <firmware>
            <feature enabled="{{ 'yes' if 'secure-boot' is in vm_features else 'no' }}" name="secure-boot"/>
        </firmware>
{% endif %}
    </os>
    <features>
        <acpi />
        <apic />
{% if "windows" in vm_features %}
        <hyperv mode="custom">
            <relaxed state="on" />
            <vapic state="on" />
            <spinlocks state="on" retries="8191" />
            <vpindex state="on" />
            <runtime state="on" />
            <synic state="on" />
            <stimer state="on">
                <direct state="on" />
            </stimer>
            <reset state="on" />
            <frequencies state="on" />
            <reenlightenment state="on" />
            <tlbflush state="on" />
            <ipi state="on" />
        </hyperv>
{% endif %}
        <vmport state="off" />
{% if "rt" in vm_features %}
        <pmu state="off" />
{% endif %}
    </features>
    <cputune>
{% if vm.cpuset is defined %}
{%     for cpu in vm.cpuset %}
{%         if "isolated" in vm_features %}
            <vcpupin vcpu="{{ loop.index - 1 }}" cpuset="{{ cpu }}"/>
{%         endif %}
{%         if "rt" in vm_features %}
            <vcpusched vcpus="{{ loop.index - 1 }}" scheduler="fifo" priority="{{ vm.rt_priority |default('1') }}" />
{%         endif %}
{%     endfor %}
{% endif %}
{% if vm.emulatorpin is defined %}
        <emulatorpin cpuset="{{ vm.emulatorpin }}"/>
{% endif %}
    </cputune>
{% if "rt" in vm_features %}
    <cpu mode="host-passthrough">
        <topology sockets="1" dies="1" cores="{{ cpu_nb }}" threads="1" />
        <feature policy="require" name="tsc-deadline" />
{% elif "windows" in vm_features %}
    <cpu mode="host-passthrough" check="partial" migratable="on">
        <topology sockets="1" dies="1" cores="{{ cpu_nb }}" threads="1" />
{% else %}
    <cpu mode="host-model" check="partial">
        <model fallback="allow" />
{% endif %}
{% if "dpdk" in vm_features %}
        <numa>
{%     if cpu_nb > 1 %}
            <cell id="0" cpus="0-{{ cpu_nb - 1 }}" memory="1" unit="GiB" memAccess="shared" />
{%     else %}
            <cell id="0" cpus="0" memory="1" unit="GiB" memAccess="shared" />
{%     endif %}
       </numa>
{% endif %}
    </cpu>
    <clock offset="utc">
        <timer name="rtc" tickpolicy="catchup" />
        <timer name="pit" tickpolicy="delay" />
        <timer name="hpet" present="no" />
{% if "windows" in vm_features %}
        <timer name="hypervclock" present="yes" />
{% endif %}
    </clock>
    <on_poweroff>destroy</on_poweroff>
    <on_reboot>restart</on_reboot>
    <on_crash>destroy</on_crash>
    <pm>
        <suspend-to-mem enabled="no" />
        <suspend-to-disk enabled="no" />
    </pm>
    <devices>
        <emulator>/usr/bin/qemu-system-x86_64</emulator>
{% if "graphic-console" in vm_features %}
        <graphics type="vnc" port="-1" autoport="yes" listen="{{ vm.graphics_listen | default('127.0.0.1') }}">
            <listen type="address" address="{{ vm.graphics_listen | default('127.0.0.1') }}"/>
        </graphics>
        <video>
            <model type="virtio" heads="1" primary="yes"/>
        </video>
        <input type="tablet" bus="usb"/>
{% endif %}
{% if vm.standalone_main_disk is defined %}
        <disk type="file" device="disk">
           <driver name="qemu" type="{{ 'raw' if vm.disk_extract is defined and vm.disk_extract | bool else 'qcow2' }}"/>
           <source file="/var/lib/libvirt/images/{{ vm.standalone_main_disk }}"/>
           <target dev="vda" bus="virtio"/>
        </disk>
{% endif %}
{% if vm.additional_disk is defined and vm.standalone_main_disk is defined %}
{%     for file in vm.additional_disk %}
        <disk type="file" device="disk">
           <driver name="qemu" type="{{ 'raw' if vm.disk_extract is defined and vm.disk_extract | bool else 'qcow2' }}"/>
           <source file="/var/lib/libvirt/images/{{ file }}"/>
           <target dev="vd{{ 'bcdefghijklmnop'[loop.index0] }}" bus="virtio"/>
        </disk>
{%     endfor %}
{% endif %}
{% if vm.standalone_cloud_init_seed is defined %}
        <disk type="file" device="disk">
           <driver name="qemu" type="qcow2"/>
           <source file="/var/lib/libvirt/images/{{ vm.standalone_cloud_init_seed }}"/>
           <target dev="vdz" bus="virtio"/>
        </disk>
{% endif %}
{% if "dpdk" in vm_features %}
{%     for interface in vm.dpdk %}
        <interface type='vhostuser'>
            <source type='unix' path='/var/run/openvswitch/vm-sockets/dpdkvhostuser_{{ interface.ovs_port }}' mode='server'/>
            <mac address="{{ interface.mac_address }}" />
            <model type='virtio'/>
            <driver name='vhost' rx_queue_size='1024' tx_queue_size='1024' queues="{{ cpu_nb }}">
                <host mrg_rxbuf='on'/>
            </driver>
        </interface>
{%     endfor %}
{% endif %}
{% if vm.pci_passthrough is defined %}
{%     for pci in vm.pci_passthrough %}
        <hostdev mode="subsystem" type="pci" managed="yes">
            <source>
                <!-- The source is the NIC PIC address -->
                <address domain="{{ pci.domain }}" bus="{{ pci.bus }}" slot="{{ pci.slot }}" function="{{ pci.function }}"/>
            </source>
{%         if pci.guest_address is defined %}
            {{ guest_pci_address(pci.guest_address) }}
{%         endif %}
        </hostdev>
{%     endfor %}
{% endif %}
{% if vm.direct_interfaces is defined %}
{%     for interface in vm.direct_interfaces %}
        <interface type="direct" {% if interface.trustGuestRxFilters is defined and interface.trustGuestRxFilters %} trustGuestRxFilters="yes" {% endif %} >
            <source dev="{{ interface.source }}" {% if interface.mode  is defined %} mode="{{ interface.mode }}" {% endif %}/>
            <mac address="{{ interface.mac_address }}"/>
            <model type="virtio"/>
        </interface>
{%     endfor %}
{% endif %}
{% if vm.bridges is defined %}
{%     for bridge in vm.bridges %}
        <interface type="bridge">
            <source bridge="{{ bridge.name }}"/>
            <mac address="{{ bridge.mac_address }}"/>
            <model type="virtio"/>
{%         if bridge.rx_queue_size is defined %}
            <driver rx_queue_size="{{ bridge.rx_queue_size }}"/>
{%         endif %}
{%         if bridge.type is defined %}
                <virtualport type='{{ bridge.type }}'/>
{%         endif %}
{%         if bridge.vlan is defined %}
                <vlan>
                    <tag id='{{ bridge.vlan.vlan_tag }}'/>
                </vlan>
{%         endif %}
{%         if bridge.guest_address is defined %}
            {{ guest_pci_address(bridge.guest_address) }}
{%         endif %}
        </interface>
{%     endfor %}
{% endif %}
{% if vm.ovs is defined %}
{%     for bridge in vm.ovs %}
        <interface type="ethernet">
            <mac address="{{ bridge.mac_address }}"/>
            <target dev="{{ bridge.ovs_port }}" managed="no"/>
            <model type="virtio"/>
{%         if bridge.rx_queue_size is defined %}
            <driver rx_queue_size="{{ bridge.rx_queue_size }}"/>
{%         endif %}
        </interface>
{%     endfor %}
{% endif %}
{% if vm.sriov is defined %}
{%     for interface in vm.sriov %}
        <interface type="network">
            <source network="{{ interface }}" />
        </interface>
{%     endfor %}
{% endif %}
        <controller type="pci" index="0" model="pcie-root" />
{% for root_port_index in pinned_root_port_indexes %}
        <controller type="pci" index="{{ root_port_index }}" model="pcie-root-port">
            <address type="pci" domain="0x0000" bus="0x00" slot="{{ "0x%02x" | format(2 + (root_port_index - 1) // 8) }}" function="{{ "0x%x" | format((root_port_index - 1) % 8) }}"/>
        </controller>
{% endfor %}
        <serial type="pty">
            <target type="isa-serial" port="0">
                <model name="isa-serial" />
            </target>
        </serial>
        <console type="pty">
            <target type="serial" port="0" />
        </console>
{% if "memballoon" in vm_features %}
        <memballoon model="virtio">
          <stats period="5" />
        </memballoon>
{% else %}
        <memballoon model="none" />
{% endif %}
        <watchdog model="i6300esb" action="poweroff" />
    </devices>
</domain>
