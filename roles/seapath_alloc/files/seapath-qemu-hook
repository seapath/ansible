# libvirt aborts the VM start when a hook exits non-zero. Whatever goes wrong
# here, including before the package is loaded (partial deployment, syntax
# error, missing module), the hook exits 0 and the VM starts unpinned.
import sys

try:
    sys.path.insert(0, '/usr/lib/seapath')
    from seapath_alloc.hook import main
    main()
except Exception as exc:
    print(f"seapath-qemu-hook: pinning skipped: {exc!r}", file=sys.stderr)
sys.exit(0)
