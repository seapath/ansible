// Generated by Ansible (configure_libvirt). Do not edit.
// Non-root access to libvirt is disabled: deny every libvirt polkit action
// to the other users, before the distribution rules can grant it.
{% set allowed = ['root'] + ([configure_libvirt_socket_trusted_user] if configure_libvirt_socket_trusted_group else []) %}
var seapathLibvirtUsers = {{ allowed | to_json }};
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.libvirt.") === 0 &&
        seapathLibvirtUsers.indexOf(subject.user) < 0) {
        return polkit.Result.NO;
    }
});
