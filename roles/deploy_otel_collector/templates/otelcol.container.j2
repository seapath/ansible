[Unit]
Description=OpenTelemetry collector
After=network-online.target
Wants=network-online.target
# No ordering against podman.socket, libvirt or Pacemaker: a target that is not
# up yet is a scrape that fails, which the collector reports as up=0 and
# retries at the next interval. Ordering the collector behind every exporter it
# reads would only delay the moment that becomes visible.

[Container]
Image={{ deploy_otel_collector_image }}
ContainerName={{ deploy_otel_collector_service }}
{% if deploy_otel_collector_tls_enabled | bool %}
# The image runs as uid 10001, and what this serves is a TLS key that belongs
# to root and is readable by root alone. Numeric, because the image carries no
# passwd file and `User=root` fails to resolve; and root rather than the key
# being handed to 10001, because that uid is the image's own choice and a
# mirrored or rebuilt image is free to make another.
User=0:0
{% endif %}
# The host network namespace, because the targets are on the host's loopback.
Network=host
Volume={{ deploy_otel_collector_config_file }}:/etc/otelcol/config.yaml:ro
{% if deploy_otel_collector_tls_enabled | bool %}
Volume={{ deploy_otel_collector_tls_dir }}:{{ deploy_otel_collector_tls_dir }}:ro
{% endif %}
SecurityLabelDisable=true
Exec=--config=/etc/otelcol/config.yaml

[Service]
Restart=always
RestartSec=5
{% if deploy_otel_collector_cpu_affinity %}
# Housekeeping CPUs, the complement of isolcpus. Scraping six endpoints every
# {{ deploy_otel_collector_scrape_interval }} must never compete with a real time guest.
CPUAffinity={{ deploy_otel_collector_cpu_affinity }}
CPUQuota={{ deploy_otel_collector_cpu_quota }}
Nice={{ deploy_otel_collector_nice }}
{% endif %}

[Install]
WantedBy=multi-user.target
