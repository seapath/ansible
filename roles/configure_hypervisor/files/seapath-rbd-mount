#
# seapath-rbd-mount - map a Ceph RBD image and mount it.
#
# Usage: seapath-rbd-mount <image-name> [<size>]
#
# Maps rbd/<image-name> and mounts it at /mnt/rbd/<image-name>.
#
# Wraps the full lifecycle needed before a container can use an RBD-backed
# volume: dirty-state cleanup, image creation on first use, the wait for the
# previous holder to let go of it, device mapping, filesystem creation on
# first use, mounting, and growing the filesystem to an image grown since it
# was made.
#
# The script is idempotent: calling it again while the image is already
# correctly mapped and mounted is a no-op, and it is safe to call from
# ExecStartPre= even if a previous service run was interrupted partway
# through (e.g. crash between mount and umount).
#
# Arguments:
#   image-name   Name of the RBD image (pool: rbd, mountpoint: /mnt/rbd/<name>)
#   size         Image size passed to rbd create, only used if the image does
#                not yet exist (default: 1G, accepts any rbd suffix: M, G, T)
#
# Filesystem: ext4.  The device is formatted only once, on first use, when
# blkid reports no existing filesystem signature.
#
# Requires: rbd, jq, blkid, mkfs.ext4, resize2fs, findmnt, mount, and coreutils
# (readlink, wc, tr).
#
# Exit: 0 on success, non-zero on any failure in the map/format/mount steps.
# The individual cleanup commands are best-effort, but the script aborts if the
# mountpoint or the device mappings cannot be cleared, rather than stacking a
# second mount or mapping on top of ones still in use.

set -euo pipefail

IMAGE="${1:?Usage: seapath-rbd-mount <image-name> [<size>]}"
SIZE="${2:-1G}"

POOL="rbd"
RBD_IMAGE="${POOL}/${IMAGE}"
MOUNTPOINT="/mnt/rbd/${IMAGE}"
DEV_PATH="/dev/rbd/${POOL}/${IMAGE}"

WAIT_TIMEOUT=300
WAIT_INTERVAL=10
WAIT_ATTEMPT_TIMEOUT=15
# Comfortably longer than one iteration (attempt + sleep), so the start
# deadline is always pushed past the next attempt.
EXTEND_USEC=$(((WAIT_INTERVAL + WAIT_ATTEMPT_TIMEOUT) * 2 * 1000000))
# A node that lost the cluster gets 100 s to stop its workload (stop_timeout
# of deploy_containers_cluster), and the watch of a client that vanished
# expires 30 s later (osd_client_watch_timeout).
RELEASE_TIMEOUT=150
RELEASE_INTERVAL=5

log() { echo "seapath-rbd-mount: $*" >&2; }
die() { log "$*"; exit 1; }
count_lines() { printf '%s\n' "$1" | wc -l; }

notify_warned=0

# extend_deadline - push the start deadline of the calling unit back
extend_deadline() {
    systemd-notify "EXTEND_TIMEOUT_USEC=${EXTEND_USEC}" 2> /dev/null && return 0

    if [ "$notify_warned" -eq 0 ]; then
        log "systemd-notify refused: the wait is capped by the" \
            "caller's own timeout, not by the helper's"
        notify_warned=1
    fi
}

command -v jq > /dev/null 2>&1 || die "jq is required but not installed"

# ---------------------------------------------------------------------------
# mapped_devices - print the device node of every kernel mapping of this image
#
# `rbd device list --format json` returns one object per mapping, the image
# under "name" (the text output heads that column "image", the JSON never
# did):
#
#   [{"id":"0","pool":"rbd","namespace":"","name":"foo",
#     "snap":"-","device":"/dev/rbd0"}]
#
# Clients older than Nautilus (14) write no "namespace" (nor, before 13, any
# "id"): a missing namespace is the default one, "".
#
# All four identity fields are matched rather than the image name alone, so a
# different pool or namespace holding an image of the same name is never
# touched.  snap == "-" selects read-write mappings, the only kind these
# helpers ever create: a snapshot mapping of the same image was made by
# something else and is none of our business.
#
# Enumerating the list is required because the stable symlink
# /dev/rbd/<pool>/<image> points only to the most recent mapping.  Earlier
# stale mappings from interrupted runs accumulate as /dev/rbdN and can only be
# found here.
# ---------------------------------------------------------------------------

mapped_devices() {
    rbd device list --format json 2> /dev/null | jq -r \
        --arg pool "$POOL" --arg image "$IMAGE" '
            .[]
            | select(.pool == $pool and (.namespace // "") == ""
                     and .name == $image and .snap == "-")
            | .device
        '
}

# ---------------------------------------------------------------------------
# is_already_mounted - true when the image is mapped exactly once and the
# mountpoint is served by that very device.
#
# Guards a re-run against a healthy, in-use mount (ExecStartPre= firing again
# before ExecStopPost= tore anything down): the cleanup below would unmount it
# from under the running container.  Anything ambiguous (no mapping, several
# mappings, stacked mounts, mounted from a stale device) returns false and
# goes through the cleanup.
#
# Both sides are resolved with readlink -f because findmnt may report either
# the stable symlink or /dev/rbdN, and the resolved value must be non-empty:
# comparing two failed resolutions would otherwise match.
# ---------------------------------------------------------------------------

is_already_mounted() {
    local devs mount_src mounted_real mapped_real

    devs="$1"
    [ -n "$devs" ] && [ "$(count_lines "$devs")" -eq 1 ] || return 1

    mount_src="$(findmnt -rn -o SOURCE "$MOUNTPOINT" 2> /dev/null || true)"
    [ -n "$mount_src" ] && [ "$(count_lines "$mount_src")" -eq 1 ] || return 1

    mounted_real="$(readlink -f "$mount_src" 2> /dev/null || true)"
    mapped_real="$(readlink -f "$devs" 2> /dev/null || true)"
    [ -n "$mounted_real" ] && [ "$mounted_real" = "$mapped_real" ]
}

# Tolerate a failing rbd/jq here: the guard is only an optimisation, and a
# broken rbd must surface on the map step below, not as a silent early exit.
current_devs="$(mapped_devices || true)"

if is_already_mounted "$current_devs"; then
    log "$RBD_IMAGE already mapped and mounted at $MOUNTPOINT, nothing to do"
    exit 0
fi

# ---------------------------------------------------------------------------
# Dirty-state cleanup
#
# If a previous run of the service was interrupted (OOM kill, SIGKILL, host
# crash with /run on tmpfs + late umount ordering), the device may still be
# mapped and/or the mountpoint may still be active.  Clean that up before
# proceeding so the rest of the script is deterministic.
#
# The individual commands are best-effort; the check right after them verifies
# the state is actually clear and aborts if it is not.
# ---------------------------------------------------------------------------

while findmnt -rn "$MOUNTPOINT" > /dev/null 2>&1; do
    log "$MOUNTPOINT still mounted, unmounting (dirty cleanup)"
    umount "$MOUNTPOINT" || break
done

while IFS= read -r stale_dev; do
    log "unmapping stale $stale_dev (dirty cleanup)"
    rbd unmap "$stale_dev" || true
done < <(mapped_devices)

# ---------------------------------------------------------------------------
# Refuse to stack if the cleanup did not clear the state
#
# rbd map does not refuse a second mapping of the same image, and mount does
# not refuse an over-mount.  So a cleanup blocked by a busy device or
# mountpoint (a process still holding files open) would otherwise be followed
# by a silent second mapping and a second, shadowing mount.  Abort instead.
# ---------------------------------------------------------------------------

if findmnt -rn "$MOUNTPOINT" > /dev/null 2>&1; then
    die "$MOUNTPOINT still mounted after cleanup, refusing to stack a second mount"
fi

remaining="$(mapped_devices || true)"
if [ -n "$remaining" ]; then
    die "$RBD_IMAGE still mapped after cleanup" \
        "($(printf '%s' "$remaining" | tr '\n' ' ')), refusing to stack a second mapping"
fi

# ---------------------------------------------------------------------------
# wait_for_pool - block until the pool answers
#
# Everything above this point is local state: /sys/bus/rbd through
# `rbd device list`, and the mount table.  Everything below needs the cluster
# to answer.  At boot the quorum forms a minute or two after
# network-online.target, which is when the calling unit starts, so the
# `rbd info` below would fail on a node that is otherwise perfectly healthy,
# and `Restart=` would then retry the container against a cluster that is
# still forming.
#
# Listing the pool is the readiness criterion rather than a mon ping: it is
# exactly what the steps below need to succeed (quorum reached, OSD map
# received, pool present and readable with the local keyring).
#
# Each attempt is wrapped in `timeout` because rbd retries a mon connection on
# its own for far longer than the interval, which would make the deadline
# meaningless.
#
# EXTEND_TIMEOUT_USEC is what allows a 300 s wait inside ExecStartPre=:
# TimeoutStartSec covers the whole start-up, ExecStartPre= included, and
# defaults to 90 s.  Each notification pushes that deadline back.  It requires
# NotifyAccess=all, which podman's quadlet generator emits for every container
# unit.  Outside that context (run by hand, or from a unit that is not
# Type=notify) the notification is refused, the wait is capped by the caller's
# own timeout, and the log line below says so once.
# ---------------------------------------------------------------------------

wait_for_pool() {
    local deadline=$((SECONDS + WAIT_TIMEOUT))

    while :; do
        if timeout "$WAIT_ATTEMPT_TIMEOUT" rbd --pool "$POOL" ls \
            > /dev/null 2>&1; then
            return 0
        fi

        [ "$SECONDS" -lt "$deadline" ] || break

        extend_deadline
        log "waiting for Ceph pool $POOL ..."
        sleep "$WAIT_INTERVAL"
    done

    die "Ceph pool $POOL not reachable after ${WAIT_TIMEOUT}s"
}

wait_for_pool

# ---------------------------------------------------------------------------
# wait_for_release - block until no client watches the image
#
# The exclusive lock of the image only arbitrates between clients that talk to
# each other: krbd hands the lock over to whoever asks, so a holder that is
# alive would give it up and two nodes would mount the same ext4.  It is meant
# for a holder that is gone, and only a watch distinguishes the two.
#
# rbd map -o exclusive would refuse a live holder by itself, but it refuses
# everybody else as well: rbd snap create and rbd resize fail with EROFS on a
# mounted image, and the backup and the growth of an image run from another
# node.
#
# A mapping of this image on this node was cleared above, so a watcher here is
# another node.  It either lets go, as it stops its workload, or vanishes when
# its watch expires.  One still there at the deadline is a node still using
# the image: the start fails rather than share it.
# ---------------------------------------------------------------------------

wait_for_release() {
    local deadline=$((SECONDS + RELEASE_TIMEOUT))
    local watchers

    while :; do
        watchers="$(rbd status "$RBD_IMAGE" --format json \
            | jq -r '[.watchers[].address] | join(" ")')"
        [ -n "$watchers" ] || return 0

        [ "$SECONDS" -lt "$deadline" ] || break

        extend_deadline
        log "$RBD_IMAGE still watched by $watchers ..."
        sleep "$RELEASE_INTERVAL"
    done

    die "$RBD_IMAGE still watched by $watchers after ${RELEASE_TIMEOUT}s," \
        "refusing to share it"
}

# ---------------------------------------------------------------------------
# Create the RBD image on first use
#
# rbd info exits non-zero when the image does not exist.  We create it with
# the layering feature (required for clone/snapshot, harmless otherwise),
# exclusive-lock and the caller-supplied size.
#
# exclusive-lock is what fences a node cut off from the cluster.  Its stop
# cannot finish: umount has to flush to the Ceph it lost, so its kernel client
# lives on with writes pending, and without fencing Pacemaker starts the
# workload elsewhere.  When the network comes back those writes are sent again,
# onto an ext4 mounted by another node.  With the lock, the first write of the
# new node finds a holder without a watch, breaks the lock and blocklists it:
# what it had pending is refused.
#
# An image made before that is given the feature here, at the first mount that
# finds nobody on it.  On subsequent runs this block only checks.
# ---------------------------------------------------------------------------

if ! rbd info "$RBD_IMAGE" > /dev/null 2>&1; then
    log "creating RBD image $RBD_IMAGE (size $SIZE)"
    rbd create "$RBD_IMAGE" --size "$SIZE" \
        --image-feature layering,exclusive-lock
else
    wait_for_release

    if ! rbd info "$RBD_IMAGE" --format json \
        | jq -e '.features | index("exclusive-lock")' > /dev/null; then
        log "enabling exclusive-lock on $RBD_IMAGE"
        rbd feature enable "$RBD_IMAGE" exclusive-lock
    fi
fi

# ---------------------------------------------------------------------------
# Map the block device
#
# After a successful rbd map, the kernel exposes the device both as
# /dev/rbdN (dynamically assigned number) and as the stable symlink
# /dev/rbd/<pool>/<image>, which we use throughout this script.
#
# noshare gives the mapping its own client: the mappings of a node otherwise
# share one, and a blocklist, which names a client, would take all of them
# down, and refuse the next map on that node until they were all gone.
# ---------------------------------------------------------------------------

rbd map "$RBD_IMAGE" -o noshare

# ---------------------------------------------------------------------------
# Ensure mountpoint exists
# ---------------------------------------------------------------------------

mkdir -p "$MOUNTPOINT"

# ---------------------------------------------------------------------------
# Format on first use
#
# blkid exits non-zero when the device has no recognisable filesystem
# signature, which is exactly the case for a freshly created RBD image.
# We format with ext4 (quiet mode to suppress the progress output).
# On subsequent runs the filesystem already exists and this step is skipped.
# ---------------------------------------------------------------------------

if ! blkid "$DEV_PATH" > /dev/null 2>&1; then
    log "no filesystem on $DEV_PATH, formatting ext4"
    mkfs.ext4 -q "$DEV_PATH"
fi

# ---------------------------------------------------------------------------
# Mount
# ---------------------------------------------------------------------------

mount "$DEV_PATH" "$MOUNTPOINT"
log "$RBD_IMAGE mounted at $MOUNTPOINT"

# ---------------------------------------------------------------------------
# Grow the filesystem to the image
#
# deploy_containers_cluster grows an image when its entry asks for more room,
# and grows the filesystem of the node that has it mounted.  An image grown
# while no node had it mounted, or whose growth stopped half way, holds a
# filesystem smaller than its device: resize2fs grows it online, before the
# container sees it, and does nothing when it already fills the device.
#
# A failure is logged and the mount kept: the workload starts with the room
# it had rather than not at all.
# ---------------------------------------------------------------------------

if ! resized="$(resize2fs "$DEV_PATH" 2>&1)"; then
    log "growing the filesystem of $RBD_IMAGE failed, kept as it is:" \
        "$(printf '%s' "$resized" | tr '\n' ' ')"
elif [[ "$resized" != *"Nothing to do"* ]]; then
    log "filesystem of $RBD_IMAGE grown to its image"
fi
