# First, set some global options.
options {
        chain-hostnames(off);
        bad-hostname("^gconfd$");
        use-dns(no);
        dns-cache(no);
        use-fqdn(no);

        perm(0640);

        flush-lines(0);
        stats-freq(0);
};

########################
# Sources
########################
source s_local_journal {
        systemd_journal();
};

########################
# Destinations
########################
{% if syslog_local is defined %}
destination d_syslog { file("/var/log/syslog-ng/syslog.local"); };
{% endif %}

{% if syslog_server_ip is defined %}
destination d_net {
        network(
                "{{ syslog_server_ip }}"
{% if syslog_tls_ca is defined and syslog_tls_key is defined and syslog_tls_server_ca is defined%}
                port({{ syslog_tls_port | default(6514) }})
                transport("tls")
                tls(
                        key-file("/etc/syslog-ng/cert.d/clientkey.pem")
                        cert-file("/etc/syslog-ng/cert.d/clientcert.pem")
                        ca-file("/etc/syslog-ng/ca.d/serverca.pem")
                        peer-verify({{ syslog_tls_peer_verify }})
{% if syslog_tls_ssl_options %}
                        ssl-options({{ syslog_tls_ssl_options | join(", ") }})
{% endif %}
{% if syslog_tls_cipher_suite %}
                        cipher-suite("{{ syslog_tls_cipher_suite }}")
{% endif %}
{% if syslog_tls_trusted_dn is defined and syslog_tls_trusted_dn %}
                        trusted-dn({% for dn in syslog_tls_trusted_dn %}"{{ dn }}"{{ ", " if not loop.last }}{% endfor %})
{% endif %}
{% if syslog_tls_trusted_keys is defined and syslog_tls_trusted_keys %}
                        trusted-keys({% for key in syslog_tls_trusted_keys %}"{{ key }}"{{ ", " if not loop.last }}{% endfor %})
{% endif %}
                )
{% else %}
                port({{ syslog_tcp_port | default(601) }})
                transport("tcp")
{% endif %}
                time_zone("UTC")
{% if syslog_structured_data | bool %}
                flags(syslog-protocol)
{% endif %}
{% if syslog_disk_buffer | bool %}
                disk-buffer(
                        dir("{{ syslog_disk_buffer_dir }}")
                        disk-buf-size({{ syslog_disk_buffer_size }})
{% if syslog_disk_buffer_reliable | bool %}
                        reliable(yes)
                        mem-buf-size({{ syslog_disk_buffer_mem_size }})
{% else %}
                        reliable(no)
                        mem-buf-length({{ syslog_disk_buffer_mem_length }})
{% endif %}
                )
{% endif %}
        );
};
{% endif %}

########################
# Log paths
########################
{% if syslog_local is defined %}
log {
        source(s_local_journal);
        destination(d_syslog);
};
{% endif %}
{% if syslog_server_ip is defined %}
log {
        source(s_local_journal);
{% if ansible_distribution == 'Debian' and ansible_distribution_version | int < 12 %}
        if (program("libvirtd")) {
                rewrite { set-facility("daemon"); };
        };
{% endif %}
{% if syslog_structured_data | bool %}
        rewrite {
                set("{{ syslog_nodename }}" value(".SDATA.{{ syslog_sd_id }}.nodename"));
{% if syslog_cluster is defined %}
                set("{{ syslog_cluster }}" value(".SDATA.{{ syslog_sd_id }}.cluster"));
{% endif %}
        };
{% endif %}
        destination(d_net);
};
{% endif %}
