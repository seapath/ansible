// Generated by Ansible (configure_libvirt). Do not edit.
// Non-root access to libvirt is disabled: deny every libvirt polkit action
// to non-root subjects, before the distribution rules can grant it.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.libvirt.") === 0 && subject.user !== "root") {
        return polkit.Result.NO;
    }
});
